/*
 * משאבי המשגר — האייקון, וזה הכול.
 *
 * למה במשגר דווקא: המתאם הוא תוצר של `dart compile exe`, ו-Dart אינו יודע
 * להטביע אייקון בקובץ שהוא מייצר. המשגר, לעומתו, מקומפל כאן ב-MSVC, ולכן
 * הוא המקום היחיד בחבילה שיכול לשאת אייקון משל עצמו — וממילא הוא התהליך
 * שהמשתמש מפעיל, בקיצור הדרך ובעליית המחשב.
 *
 * המזהה הוא 1 בכוונה: Windows מציג לקובץ הפעלה את האייקון בעל המזהה
 * הנומרי הקטן ביותר.
 *
 * chavruta-small.ico ולא chavruta.ico: הגרסה הקטנה נעצרת ב-64 פיקסל, כי
 * האייקון המוטבע בקובץ הפעלה נראה רק במנהל המשימות, בתיבת חומת האש
 * ובעיון בתיקיית ההתקנה. הגדלים הגדולים נחוצים לקיצור הדרך ולמתקין,
 * ואלה קוראים את קובץ ה-ico המותקן לצד התוכנה — לא את המשאב הזה. הרקע
 * המלא בראש tool\make-icon.ps1.
 */

#define IDI_CHAVRUTA 1

IDI_CHAVRUTA ICON "..\\assets\\chavruta-small.ico"
